# Deploywise AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with real secrets to version control.

# Application Information
APP_NAME=Deploywise AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Database Configuration (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./deploywise.db

# LLM Provider Configuration ("gemini" | "ollama" | "fake")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM Resilience Settings
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=1

# Security & CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
MAX_IMPORT_SIZE_BYTES=262144
MAX_STAGES=100
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
